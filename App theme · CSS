@import url('https://fonts.googleapis.com/css2?family=Manrope:wght@400;500;600;700;800&family=Noto+Serif+Devanagari:wght@500;600;700&display=swap');

/* =========================================================
   SIDDHA ASTRO — PREMIUM LIGHT UI
   Calm • Sacred • Modern • Responsive
   ========================================================= */

*,
*::before,
*::after {
  box-sizing: border-box;
}

html {
  scroll-behavior: smooth;
  -webkit-text-size-adjust: 100%;
}

:root {
  /* Premium light palette */
  --bg-primary-light: #f7f8f5;
  --bg-secondary-light: #ffffff;
  --bg-tertiary-light: #eef2ed;
  --surface-soft-light: #f3f5f1;
  --text-primary-light: #24302b;
  --text-secondary-light: #66716c;
  --text-muted-light: #89928d;
  --accent-light: #a27a2a;
  --accent-dark-light: #80601e;
  --accent-soft-light: #f4ead3;
  --sage-light: #52766a;
  --sage-soft-light: #e7efeb;
  --border-light: #dfe5df;
  --shadow-light: rgba(31, 48, 40, 0.08);
  --shadow-strong-light: rgba(31, 48, 40, 0.13);

  /* Dark mode retained as an option */
  --bg-primary-dark: #101916;
  --bg-secondary-dark: #17221e;
  --bg-tertiary-dark: #1d2b25;
  --surface-soft-dark: #203029;
  --text-primary-dark: #edf3ef;
  --text-secondary-dark: #b9c7c0;
  --text-muted-dark: #91a39a;
  --accent-dark: #d7b35b;
  --accent-dark-dark: #f0cf79;
  --accent-soft-dark: #3a321f;
  --sage-dark: #8bb5a5;
  --sage-soft-dark: #263b33;
  --border-dark: #2b3a34;
  --shadow-dark: rgba(0, 0, 0, 0.28);
  --shadow-strong-dark: rgba(0, 0, 0, 0.42);

  /* Shared spiritual palette */
  --spiritual-gold: #a27a2a;
  --spiritual-purple: #70628a;
  --spiritual-blue: #55766f;
  --spiritual-saffron: #b97842;
  --spiritual-orange: #b97842;

  --base-font-size: 16px;
  --scale: 1;

  --spacing-xs: 4px;
  --spacing-sm: 8px;
  --spacing-md: 16px;
  --spacing-lg: 24px;
  --spacing-xl: 32px;

  --radius-sm: 10px;
  --radius-md: 16px;
  --radius-lg: 22px;
  --radius-pill: 999px;
}

/* Theme tokens */
body.light-mode {
  --bg-primary: var(--bg-primary-light);
  --bg-secondary: var(--bg-secondary-light);
  --bg-tertiary: var(--bg-tertiary-light);
  --surface-soft: var(--surface-soft-light);
  --text-primary: var(--text-primary-light);
  --text-secondary: var(--text-secondary-light);
  --text-muted: var(--text-muted-light);
  --accent: var(--accent-light);
  --accent-dark: var(--accent-dark-light);
  --accent-soft: var(--accent-soft-light);
  --sage: var(--sage-light);
  --sage-soft: var(--sage-soft-light);
  --border: var(--border-light);
  --shadow: var(--shadow-light);
  --shadow-strong: var(--shadow-strong-light);
}

body.dark-mode {
  --bg-primary: var(--bg-primary-dark);
  --bg-secondary: var(--bg-secondary-dark);
  --bg-tertiary: var(--bg-tertiary-dark);
  --surface-soft: var(--surface-soft-dark);
  --text-primary: var(--text-primary-dark);
  --text-secondary: var(--text-secondary-dark);
  --text-muted: var(--text-muted-dark);
  --accent: var(--accent-dark);
  --accent-dark: var(--accent-dark-dark);
  --accent-soft: var(--accent-soft-dark);
  --sage: var(--sage-dark);
  --sage-soft: var(--sage-soft-dark);
  --border: var(--border-dark);
  --shadow: var(--shadow-dark);
  --shadow-strong: var(--shadow-strong-dark);
}

/* =========================================================
   BASE
   ========================================================= */

body {
  margin: 0;
  min-height: 100vh;
  background:
    radial-gradient(circle at 10% 0%, rgba(162, 122, 42, 0.055), transparent 28%),
    radial-gradient(circle at 90% 8%, rgba(82, 118, 106, 0.06), transparent 30%),
    var(--bg-primary-light);
  color: var(--text-primary-light);
  font-family: 'Manrope', -apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif;
  font-size: calc(var(--base-font-size) * var(--scale));
  line-height: 1.65;
  letter-spacing: -0.01em;
  transition: background 0.35s ease, color 0.35s ease;
}

body.dark-mode {
  background:
    radial-gradient(circle at 10% 0%, rgba(215, 179, 91, 0.07), transparent 28%),
    radial-gradient(circle at 90% 8%, rgba(139, 181, 165, 0.06), transparent 30%),
    var(--bg-primary-dark);
  color: var(--text-primary-dark);
}

::selection {
  background: var(--accent-soft);
  color: var(--text-primary);
}

a {
  color: inherit;
}

button,
input,
select,
textarea {
  font: inherit;
}

button,
a {
  -webkit-tap-highlight-color: transparent;
}

/* Sanskrit / Indic text */
.sanskrit,
.mantra-text,
.sloka-text {
  font-family: 'Noto Serif Devanagari', Georgia, serif;
}

/* =========================================================
   APP SHELL
   ========================================================= */

.app-container {
  min-height: 100vh;
  display: flex;
  flex-direction: column;
  padding-bottom: 94px;
  background: transparent;
}

.app-header {
  position: sticky;
  top: 0;
  z-index: 100;
  padding: 18px 20px 17px;
  text-align: center;
  color: var(--text-primary);
  background: rgba(255, 255, 255, 0.88);
  border-bottom: 1px solid rgba(223, 229, 223, 0.9);
  box-shadow: 0 8px 28px rgba(31, 48, 40, 0.055);
  backdrop-filter: blur(18px);
  -webkit-backdrop-filter: blur(18px);
}

body.dark-mode .app-header {
  color: var(--text-primary);
  background: rgba(23, 34, 30, 0.88);
  border-bottom-color: var(--border);
}

.app-header h1 {
  margin: 0 0 3px;
  font-size: clamp(1.45rem, 4vw, 1.9rem);
  line-height: 1.2;
  font-weight: 800;
  letter-spacing: -0.045em;
  color: var(--text-primary);
}

.app-header h1::first-letter {
  color: var(--accent);
}

.app-header-subtitle {
  color: var(--text-secondary);
  font-size: 0.76rem;
  font-weight: 600;
  letter-spacing: 0.08em;
  text-transform: uppercase;
}

.app-content {
  flex: 1;
  width: 100%;
  max-width: 1120px;
  margin: 0 auto;
  padding: 28px 20px;
  overflow: visible;
}

/* =========================================================
   CONTROLS
   ========================================================= */

.controls-bar {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 12px;
  margin-bottom: 24px;
  padding: 9px;
  background: rgba(255, 255, 255, 0.82);
  border: 1px solid var(--border);
  border-radius: var(--radius-pill);
  box-shadow: 0 5px 18px var(--shadow);
  backdrop-filter: blur(12px);
}

body.dark-mode .controls-bar {
  background: rgba(23, 34, 30, 0.88);
}

.theme-toggle,
.font-controls {
  display: flex;
  align-items: center;
  gap: 6px;
  min-height: 42px;
  padding: 4px 8px;
  background: var(--surface-soft);
  border: 1px solid var(--border);
  border-radius: var(--radius-pill);
}

.theme-toggle {
  padding-left: 14px;
}

.theme-toggle span {
  color: var(--text-secondary);
  font-size: 0.76rem;
  font-weight: 700;
}

.theme-toggle-btn,
.font-control-btn {
  width: 34px;
  height: 34px;
  padding: 0;
  border: 0;
  border-radius: 50%;
  display: inline-flex;
  align-items: center;
  justify-content: center;
  background: var(--bg-secondary);
  color: var(--text-primary);
  cursor: pointer;
  transition: transform 0.2s ease, background 0.2s ease, box-shadow 0.2s ease;
}

.theme-toggle-btn {
  font-size: 1rem;
}

.theme-toggle-btn:hover,
.font-control-btn:hover {
  transform: translateY(-1px);
  background: var(--accent-soft);
  box-shadow: 0 4px 10px var(--shadow);
}

.font-controls {
  padding-right: 6px;
}

.font-control-btn {
  color: var(--accent);
  font-size: 1.05rem;
  font-weight: 800;
}

.font-size-display {
  min-width: 48px;
  color: var(--text-secondary);
  text-align: center;
  font-size: 0.72rem;
  font-weight: 800;
}

/* =========================================================
   BOTTOM NAV — MOBILE APP STYLE
   ========================================================= */

.bottom-nav {
  position: fixed;
  left: 50%;
  bottom: 12px;
  z-index: 1000;
  width: min(680px, calc(100% - 20px));
  transform: translateX(-50%);
  display: flex;
  align-items: stretch;
  justify-content: space-around;
  padding: 7px;
  background: rgba(255, 255, 255, 0.91);
  border: 1px solid rgba(223, 229, 223, 0.95);
  border-radius: 22px;
  box-shadow: 0 12px 36px rgba(31, 48, 40, 0.14);
  backdrop-filter: blur(22px);
  -webkit-backdrop-filter: blur(22px);
}

body.dark-mode .bottom-nav {
  background: rgba(23, 34, 30, 0.94);
  border-color: var(--border);
  box-shadow: 0 12px 36px rgba(0, 0, 0, 0.35);
}

.nav-item {
  position: relative;
  flex: 1;
  min-width: 0;
  min-height: 58px;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 2px;
  padding: 6px 5px;
  border-radius: 16px;
  text-decoration: none;
  color: var(--text-muted);
  transition: color 0.2s ease, background 0.2s ease, transform 0.2s ease;
}

.nav-item:hover {
  color: var(--sage);
  transform: translateY(-1px);
}

.nav-item.active {
  color: var(--accent);
  background: var(--accent-soft);
  font-weight: 800;
}

.nav-icon {
  font-size: 1.2rem;
  line-height: 1;
}

.nav-label {
  font-size: 0.63rem;
  line-height: 1.1;
  font-weight: 700;
  white-space: nowrap;
}

/* =========================================================
   GLOBAL CARDS / SECTIONS
   ========================================================= */

.spiritual-card,
.feature-card,
.feature-card-large,
.today-panchangam,
.about-section,
.settings-section {
  background: rgba(255, 255, 255, 0.92);
  border: 1px solid var(--border);
  border-radius: var(--radius-lg);
  box-shadow: 0 8px 26px var(--shadow);
}

body.dark-mode .spiritual-card,
body.dark-mode .feature-card,
body.dark-mode .feature-card-large,
body.dark-mode .today-panchangam,
body.dark-mode .about-section,
body.dark-mode .settings-section {
  background: rgba(23, 34, 30, 0.94);
}

.spiritual-card {
  border-left: 3px solid var(--accent);
  padding: 24px;
  margin-bottom: 20px;
  transition: transform 0.25s ease, box-shadow 0.25s ease;
}

.spiritual-card:hover {
  transform: translateY(-2px);
  box-shadow: 0 14px 34px var(--shadow-strong);
}

.spiritual-card-title {
  display: flex;
  align-items: center;
  gap: 10px;
  margin-bottom: 14px;
  color: var(--text-primary);
  font-size: 1.18rem;
  font-weight: 800;
  letter-spacing: -0.025em;
}

.spiritual-card-icon {
  color: var(--accent);
}

.spiritual-card-content {
  color: var(--text-secondary);
  line-height: 1.8;
}

/* =========================================================
   BUTTONS
   ========================================================= */

.btn,
.cta-button {
  min-height: 44px;
  border: 0;
  border-radius: 13px;
  padding: 11px 18px;
  font-weight: 800;
  letter-spacing: -0.01em;
  cursor: pointer;
  transition: transform 0.2s ease, box-shadow 0.2s ease, background 0.2s ease;
}

.btn-primary,
.cta-button {
  color: #fff !important;
  background: linear-gradient(135deg, var(--sage) 0%, var(--accent) 100%);
  box-shadow: 0 8px 20px rgba(82, 118, 106, 0.22);
}

.btn-primary:hover,
.cta-button:hover {
  transform: translateY(-2px);
  box-shadow: 0 12px 26px rgba(82, 118, 106, 0.27);
}

.btn-secondary {
  color: var(--text-primary);
  background: var(--surface-soft);
  border: 1px solid var(--border);
}

/* =========================================================
   INPUTS
   ========================================================= */

input[type="date"],
input[type="time"],
input[type="text"],
input[type="number"],
input[type="email"],
select,
textarea {
  width: 100%;
  min-height: 46px;
  margin-bottom: 14px;
  padding: 11px 14px;
  border: 1px solid var(--border);
  border-radius: 12px;
  outline: none;
  background: var(--bg-secondary);
  color: var(--text-primary);
  box-shadow: inset 0 1px 1px rgba(31, 48, 40, 0.025);
  transition: border-color 0.2s ease, box-shadow 0.2s ease, background 0.2s ease;
}

input::placeholder,
textarea::placeholder {
  color: var(--text-muted);
}

input:focus,
select:focus,
textarea:focus {
  border-color: var(--sage);
  box-shadow: 0 0 0 4px var(--sage-soft);
}

.label {
  margin-bottom: 7px;
  color: var(--text-secondary);
  font-size: 0.78rem;
  font-weight: 800;
  letter-spacing: 0.04em;
  text-transform: uppercase;
}

/* =========================================================
   BADGES
   ========================================================= */

.badge {
  display: inline-flex;
  align-items: center;
  min-height: 30px;
  padding: 5px 11px;
  margin: 0 5px 5px 0;
  border: 1px solid var(--border);
  border-radius: var(--radius-pill);
  background: var(--sage-soft);
  color: var(--sage);
  font-size: 0.76rem;
  font-weight: 800;
}

/* =========================================================
   GRID HELPERS
   ========================================================= */

.grid-2 {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 18px;
  margin-bottom: 20px;
}

.grid-3 {
  display: grid;
  grid-template-columns: repeat(3, minmax(0, 1fr));
  gap: 16px;
  margin-bottom: 20px;
}

/* =========================================================
   HOME PAGE — PREMIUM OVERRIDES
   ========================================================= */

.welcome-section {
  position: relative;
  overflow: hidden;
  padding: clamp(30px, 6vw, 54px) 24px;
  margin-bottom: 22px;
  border: 1px solid rgba(162, 122, 42, 0.16);
  border-radius: 26px;
  text-align: center;
  color: var(--text-primary);
  background:
    radial-gradient(circle at 50% 0%, rgba(162, 122, 42, 0.15), transparent 38%),
    linear-gradient(145deg, #fffdf8 0%, #f0f5f0 100%);
  box-shadow: 0 14px 42px rgba(31, 48, 40, 0.09);
}

body.dark-mode .welcome-section {
  color: var(--text-primary);
  background:
    radial-gradient(circle at 50% 0%, rgba(215, 179, 91, 0.12), transparent 38%),
    linear-gradient(145deg, #1c2823 0%, #17221e 100%);
}

.welcome-section::after {
  content: '✦';
  position: absolute;
  right: 26px;
  top: 18px;
  color: var(--accent);
  opacity: 0.28;
  font-size: 1.2rem;
}

.welcome-icon {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  width: 66px;
  height: 66px;
  margin-bottom: 14px;
  border-radius: 20px;
  background: var(--accent-soft);
  box-shadow: inset 0 0 0 1px rgba(162, 122, 42, 0.12);
  font-size: 2rem;
  animation: float 4s ease-in-out infinite;
}

.welcome-text {
  margin: 0;
  color: var(--text-primary);
  font-size: clamp(1.45rem, 5vw, 2rem);
  font-weight: 800;
  line-height: 1.3;
  letter-spacing: -0.04em;
}

.welcome-text span {
  display: block;
  margin-top: 7px;
  color: var(--text-secondary);
  font-size: 0.78rem !important;
  font-weight: 600;
  letter-spacing: 0;
}

.daily-sloka {
  position: relative;
  overflow: hidden;
  padding: 28px 24px;
  margin-bottom: 26px;
  border: 1px solid rgba(162, 122, 42, 0.16);
  border-radius: var(--radius-lg);
  text-align: center;
  color: var(--text-primary);
  background:
    radial-gradient(circle at 50% 0%, rgba(162, 122, 42, 0.12), transparent 48%),
    var(--accent-soft);
  box-shadow: 0 10px 30px var(--shadow);
}

body.dark-mode .daily-sloka {
  background: var(--accent-soft);
}

.sloka-title {
  margin-bottom: 14px;
  color: var(--accent);
  font-size: 0.72rem;
  font-weight: 800;
  letter-spacing: 0.16em;
}

.sloka-text {
  margin-bottom: 14px;
  color: var(--text-primary);
  font-size: clamp(1.55rem, 5vw, 2.1rem);
  font-weight: 600;
  line-height: 1.65;
}

.sloka-translation {
  max-width: 720px;
  margin: 0 auto;
  padding-top: 14px;
  border-top: 1px solid rgba(162, 122, 42, 0.2);
  color: var(--text-secondary);
  font-size: 0.86rem;
  line-height: 1.7;
}

.features-grid {
  display: grid;
  grid-template-columns: repeat(3, minmax(0, 1fr));
  gap: 16px;
  margin-bottom: 28px;
}

.feature-card {
  min-height: 172px;
  padding: 22px 16px;
  text-align: center;
  cursor: pointer;
  transition: transform 0.25s ease, box-shadow 0.25s ease, border-color 0.25s ease;
}

.feature-card:hover {
  transform: translateY(-5px);
  border-color: rgba(162, 122, 42, 0.42);
  box-shadow: 0 16px 32px var(--shadow-strong);
}

.feature-icon {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 48px;
  height: 48px;
  margin: 0 auto 12px;
  border-radius: 15px;
  background: var(--sage-soft);
  font-size: 1.45rem;
}

.feature-title {
  margin-bottom: 5px;
  color: var(--text-primary);
  font-size: 0.95rem;
  font-weight: 800;
}

.feature-desc {
  color: var(--text-secondary);
  font-size: 0.75rem;
  line-height: 1.5;
}

.today-panchangam {
  padding: 22px;
  margin-bottom: 28px;
  border-left: 3px solid var(--accent);
}

.panchangam-grid {
  display: grid;
  grid-template-columns: repeat(6, minmax(0, 1fr));
  gap: 10px;
  margin-top: 16px;
}

.panchangam-item {
  min-height: 84px;
  display: flex;
  flex-direction: column;
  justify-content: center;
  padding: 11px 8px;
  border: 1px solid var(--border);
  border-radius: 14px;
  background: var(--surface-soft);
  text-align: center;
}

.panchangam-label {
  margin-bottom: 4px;
  color: var(--text-muted);
  font-size: 0.62rem;
  font-weight: 800;
  letter-spacing: 0.06em;
  text-transform: uppercase;
}

.panchangam-value {
  color: var(--text-primary);
  font-size: 0.78rem;
  font-weight: 800;
}

.festivals-grid {
  display: grid;
  grid-template-columns: repeat(3, minmax(0, 1fr));
  gap: 12px;
}

.festival-badge {
  padding: 16px;
  border: 1px solid var(--border);
  border-radius: 16px;
  background: var(--bg-secondary);
  text-align: center;
  box-shadow: 0 5px 16px var(--shadow);
  transition: transform 0.2s ease, box-shadow 0.2s ease;
}

.festival-badge:hover {
  transform: translateY(-3px);
  box-shadow: 0 10px 22px var(--shadow-strong);
}

.festival-icon {
  margin-bottom: 6px;
  font-size: 1.45rem;
}

.festival-name {
  margin-bottom: 3px;
  color: var(--text-primary);
  font-size: 0.78rem;
  font-weight: 800;
}

.festival-date {
  color: var(--text-secondary);
  font-size: 0.7rem;
}

.about-section {
  padding: 24px;
  margin-top: 28px;
}

.about-title {
  margin-bottom: 12px;
  color: var(--text-primary);
  font-size: 1.15rem;
  font-weight: 800;
}

.about-text {
  color: var(--text-secondary);
  font-size: 0.86rem;
  line-height: 1.8;
}

/* =========================================================
   MORE PAGE / LARGE CARDS
   ========================================================= */

.feature-grid-large {
  display: grid;
  grid-template-columns: repeat(3, minmax(0, 1fr));
  gap: 18px;
  margin-bottom: 28px;
}

.feature-card-large {
  overflow: hidden;
  transition: transform 0.25s ease, box-shadow 0.25s ease, border-color 0.25s ease;
}

.feature-card-large:hover {
  transform: translateY(-5px);
  border-color: rgba(162, 122, 42, 0.35);
  box-shadow: 0 16px 34px var(--shadow-strong);
}

.feature-header {
  padding: 24px 18px;
  color: var(--text-primary);
  background: linear-gradient(145deg, var(--sage-soft) 0%, var(--accent-soft) 100%);
  text-align: center;
}

.feature-icon-large {
  margin-bottom: 8px;
  font-size: 2rem;
}

.feature-title-large {
  color: var(--text-primary);
  font-size: 1.05rem;
  font-weight: 800;
}

.feature-subtitle {
  color: var(--text-secondary);
  font-size: 0.72rem;
  font-weight: 600;
}

.feature-body {
  padding: 20px;
}

.feature-description {
  color: var(--text-secondary);
  font-size: 0.8rem;
  line-height: 1.7;
}

.feature-benefits {
  padding: 12px;
  border: 1px solid var(--border);
  border-radius: 14px;
  background: var(--surface-soft);
}

.benefit-item {
  padding: 6px 0;
  color: var(--text-secondary);
  font-size: 0.76rem;
}

.benefit-icon {
  color: var(--sage);
}

.btn-link {
  display: flex;
  align-items: center;
  justify-content: center;
  min-height: 42px;
  padding: 9px 13px;
  border: 1px solid var(--border);
  border-radius: 12px;
  background: var(--bg-secondary);
  color: var(--sage);
  font-size: 0.76rem;
  font-weight: 800;
  text-decoration: none;
  transition: background 0.2s ease, transform 0.2s ease;
}

.btn-link:hover {
  background: var(--sage-soft);
  transform: translateY(-1px);
}

/* =========================================================
   MANTRA / SPIRITUAL ELEMENTS
   ========================================================= */

.mantra-box {
  padding: 28px 22px;
  border: 1px solid rgba(162, 122, 42, 0.16);
  border-radius: var(--radius-lg);
  background: var(--accent-soft);
  color: var(--text-primary);
  text-align: center;
  line-height: 1.9;
  box-shadow: 0 10px 28px var(--shadow);
}

.mantra-title {
  margin-bottom: 10px;
  color: var(--accent);
  font-size: 0.78rem;
  font-weight: 800;
  letter-spacing: 0.08em;
  text-transform: uppercase;
}

.mantra-text {
  color: var(--text-primary);
  font-size: 1.02rem;
}

/* =========================================================
   SETTINGS / INFO
   ========================================================= */

.settings-section {
  padding: 20px;
  margin-bottom: 18px;
}

.settings-title {
  margin-bottom: 16px;
  color: var(--text-primary);
  font-size: 1rem;
  font-weight: 800;
}

.setting-item {
  min-height: 48px;
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 12px;
  margin-bottom: 8px;
  padding: 10px 12px;
  border: 1px solid var(--border);
  border-radius: 12px;
  background: var(--surface-soft);
}

.setting-label {
  color: var(--text-primary);
  font-size: 0.78rem;
  font-weight: 700;
}

.setting-value {
  padding: 5px 9px;
  border-radius: var(--radius-pill);
  background: var(--bg-secondary);
  color: var(--text-secondary);
  font-size: 0.7rem;
  font-weight: 700;
}

.coming-soon {
  padding: 26px 20px;
  border: 1px dashed rgba(162, 122, 42, 0.48);
  border-radius: var(--radius-lg);
  background: linear-gradient(145deg, var(--accent-soft), var(--sage-soft));
  text-align: center;
}

.info-banner {
  padding: 22px;
  border: 1px solid var(--border);
  border-radius: var(--radius-lg);
  background: var(--sage-soft);
  color: var(--text-primary);
  text-align: center;
}

/* =========================================================
   ANIMATIONS
   ========================================================= */

@keyframes float {
  0%, 100% { transform: translateY(0); }
  50% { transform: translateY(-6px); }
}

@keyframes fadeIn {
  from { opacity: 0; transform: translateY(8px); }
  to { opacity: 1; transform: translateY(0); }
}

.fade-in {
  animation: fadeIn 0.4s ease both;
}

@keyframes shimmer {
  0%, 100% { opacity: 1; }
  50% { opacity: 0.7; }
}

.loading {
  animation: shimmer 1.5s infinite;
}

/* =========================================================
   ACCESSIBILITY / SCROLLBAR / PRINT
   ========================================================= */

:focus-visible {
  outline: 3px solid rgba(82, 118, 106, 0.3);
  outline-offset: 3px;
}

.sr-only {
  position: absolute;
  width: 1px;
  height: 1px;
  padding: 0;
  margin: -1px;
  overflow: hidden;
  clip: rect(0, 0, 0, 0);
  white-space: nowrap;
  border: 0;
}

::-webkit-scrollbar {
  width: 8px;
}

::-webkit-scrollbar-track {
  background: var(--bg-primary);
}

::-webkit-scrollbar-thumb {
  background: #c5cec8;
  border-radius: 999px;
}

body.dark-mode ::-webkit-scrollbar-thumb {
  background: #40534a;
}

@media (max-width: 900px) {
  .features-grid,
  .feature-grid-large {
    grid-template-columns: repeat(2, minmax(0, 1fr));
  }

  .panchangam-grid {
    grid-template-columns: repeat(3, minmax(0, 1fr));
  }

  .festivals-grid {
    grid-template-columns: repeat(2, minmax(0, 1fr));
  }
}

@media (max-width: 680px) {
  .app-header {
    padding: 15px 16px;
  }

  .app-content {
    padding: 20px 14px 26px;
  }

  .controls-bar {
    border-radius: 18px;
    padding: 7px;
  }

  .theme-toggle,
  .font-controls {
    flex: 1;
    justify-content: center;
  }

  .welcome-section {
    padding: 32px 18px;
    border-radius: 22px;
  }

  .welcome-text {
    font-size: 1.4rem;
  }

  .features-grid,
  .feature-grid-large,
  .festivals-grid,
  .grid-2,
  .grid-3 {
    grid-template-columns: 1fr;
  }

  .feature-card {
    min-height: 142px;
  }

  .panchangam-grid {
    grid-template-columns: repeat(2, minmax(0, 1fr));
  }

  .panchangam-item {
    min-height: 76px;
  }

  .bottom-nav {
    bottom: 8px;
    width: calc(100% - 12px);
    border-radius: 19px;
  }

  .nav-item {
    min-height: 54px;
  }

  .nav-icon {
    font-size: 1.05rem;
  }

  .nav-label {
    font-size: 0.58rem;
  }

  .spiritual-card,
  .today-panchangam,
  .about-section,
  .settings-section {
    padding: 18px;
  }
}

@media (max-width: 390px) {
  .theme-toggle span {
    display: none;
  }

  .panchangam-grid {
    gap: 8px;
  }

  .panchangam-item {
    padding: 9px 5px;
  }
}

@media (prefers-reduced-motion: reduce) {
  html {
    scroll-behavior: auto;
  }

  *,
  *::before,
  *::after {
    animation-duration: 0.01ms !important;
    animation-iteration-count: 1 !important;
    transition-duration: 0.01ms !important;
  }
}

@media print {
  .bottom-nav,
  .controls-bar {
    display: none !important;
  }

  .app-container {
    padding-bottom: 0;
  }

  body {
    background: #fff;
  }
}
