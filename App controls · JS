/* =========================================================
   SIDDHA ASTRO — APP CONTROLS
   Premium light-first theme + accessible font controls
   ========================================================= */

class ThemeManager {
  constructor() {
    this.LIGHT_MODE = 'light-mode';
    this.DARK_MODE = 'dark-mode';
    this.STORAGE_KEY = 'siddha-theme';
    this.init();
  }

  init() {
    // Siddha Astro is intentionally light-first: calm, readable and pleasant.
    const savedTheme = localStorage.getItem(this.STORAGE_KEY) || this.LIGHT_MODE;
    this.setTheme(savedTheme);
    this.setupToggleButton();
  }

  setTheme(theme) {
    const safeTheme = theme === this.DARK_MODE ? this.DARK_MODE : this.LIGHT_MODE;

    document.body.classList.remove(this.LIGHT_MODE, this.DARK_MODE);
    document.body.classList.add(safeTheme);
    localStorage.setItem(this.STORAGE_KEY, safeTheme);

    this.updateToggleButton(safeTheme);

    document.dispatchEvent(new CustomEvent('siddha-theme-change', {
      detail: { theme: safeTheme }
    }));
  }

  toggleTheme() {
    const nextTheme = this.isDarkMode() ? this.LIGHT_MODE : this.DARK_MODE;
    this.setTheme(nextTheme);
  }

  setupToggleButton() {
    const toggleBtn = document.getElementById('theme-toggle-btn');
    if (!toggleBtn || toggleBtn.dataset.themeBound === 'true') return;

    toggleBtn.dataset.themeBound = 'true';
    toggleBtn.addEventListener('click', () => this.toggleTheme());
  }

  updateToggleButton(theme) {
    const toggleBtn = document.getElementById('theme-toggle-btn');
    if (!toggleBtn) return;

    const dark = theme === this.DARK_MODE;
    toggleBtn.textContent = dark ? '☀️' : '🌙';
    toggleBtn.title = dark ? 'Switch to Light Mode' : 'Switch to Dark Mode';
    toggleBtn.setAttribute('aria-label', toggleBtn.title);
  }

  isDarkMode() {
    return document.body.classList.contains(this.DARK_MODE);
  }

  isLightMode() {
    return document.body.classList.contains(this.LIGHT_MODE);
  }
}

class FontSizeManager {
  constructor() {
    this.MIN_SCALE = 0.8;
    this.MAX_SCALE = 1.5;
    this.STEP = 0.1;
    this.DEFAULT_SCALE = 1;
    this.STORAGE_KEY = 'siddha-font-scale';
    this.init();
  }

  init() {
    const savedScale = parseFloat(localStorage.getItem(this.STORAGE_KEY));
    const scale = Number.isFinite(savedScale) ? savedScale : this.DEFAULT_SCALE;
    this.setScale(scale);
    this.setupControls();
  }

  setScale(scale) {
    const safeScale = Math.max(
      this.MIN_SCALE,
      Math.min(this.MAX_SCALE, Number(scale) || this.DEFAULT_SCALE)
    );

    document.documentElement.style.setProperty('--scale', safeScale);
    localStorage.setItem(this.STORAGE_KEY, safeScale);
    this.updateDisplay(safeScale);
  }

  increase() {
    this.setScale(this.getScale() + this.STEP);
  }

  decrease() {
    this.setScale(this.getScale() - this.STEP);
  }

  reset() {
    this.setScale(this.DEFAULT_SCALE);
  }

  setupControls() {
    const increaseBtn = document.getElementById('font-increase-btn');
    const decreaseBtn = document.getElementById('font-decrease-btn');
    const resetBtn = document.getElementById('font-reset-btn');

    if (increaseBtn && !increaseBtn.dataset.fontBound) {
      increaseBtn.dataset.fontBound = 'true';
      increaseBtn.addEventListener('click', () => this.increase());
    }

    if (decreaseBtn && !decreaseBtn.dataset.fontBound) {
      decreaseBtn.dataset.fontBound = 'true';
      decreaseBtn.addEventListener('click', () => this.decrease());
    }

    if (resetBtn && !resetBtn.dataset.fontBound) {
      resetBtn.dataset.fontBound = 'true';
      resetBtn.addEventListener('click', () => this.reset());
    }
  }

  updateDisplay(scale) {
    const display = document.getElementById('font-size-display');
    if (display) display.textContent = `${Math.round(scale * 100)}%`;
  }

  getScale() {
    const scale = parseFloat(localStorage.getItem(this.STORAGE_KEY));
    return Number.isFinite(scale) ? scale : this.DEFAULT_SCALE;
  }
}

class BottomNavigation {
  constructor() {
    this.init();
  }

  init() {
    this.setupActiveState();
    this.setupNavigation();
  }

  setupActiveState() {
    const currentPage = this.getCurrentPage();
    const navItems = document.querySelectorAll('.nav-item');

    navItems.forEach(item => {
      const href = item.getAttribute('href') || '';
      const targetPage = href.split('/').pop().split('?')[0];

      if (targetPage === currentPage) {
        item.classList.add('active');
        item.setAttribute('aria-current', 'page');
      } else {
        item.classList.remove('active');
        item.removeAttribute('aria-current');
      }
    });
  }

  getCurrentPage() {
    const path = window.location.pathname;
    const page = path.substring(path.lastIndexOf('/') + 1);
    return page || 'index.html';
  }

  setupNavigation() {
    document.querySelectorAll('.nav-item').forEach(item => {
      if (item.dataset.navBound === 'true') return;
      item.dataset.navBound = 'true';

      item.addEventListener('click', () => {
        const href = item.getAttribute('href');
        if (href) this.createRipple(item);
      });
    });
  }

  createRipple(item) {
    const ripple = document.createElement('span');
    ripple.setAttribute('aria-hidden', 'true');
    Object.assign(ripple.style, {
      position: 'absolute',
      left: '50%',
      top: '50%',
      width: '18px',
      height: '18px',
      borderRadius: '50%',
      background: 'currentColor',
      opacity: '0.12',
      transform: 'translate(-50%, -50%) scale(0)',
      pointerEvents: 'none'
    });

    ripple.animate(
      [
        { transform: 'translate(-50%, -50%) scale(0)', opacity: 0.16 },
        { transform: 'translate(-50%, -50%) scale(5)', opacity: 0 }
      ],
      { duration: 500, easing: 'ease-out' }
    );

    item.appendChild(ripple);
    setTimeout(() => ripple.remove(), 520);
  }
}

class PageTransition {
  constructor() {
    this.init();
  }

  init() {
    window.addEventListener('load', () => {
      document.querySelectorAll('.app-content').forEach(el => {
        el.classList.add('fade-in');
      });
    });
  }
}

let themeManager;
let fontSizeManager;
let bottomNavigation;
let pageTransition;

function initApp() {
  themeManager = new ThemeManager();
  fontSizeManager = new FontSizeManager();
  bottomNavigation = new BottomNavigation();
  pageTransition = new PageTransition();
}

if (document.readyState === 'loading') {
  document.addEventListener('DOMContentLoaded', initApp);
} else {
  initApp();
}

function getCurrentTheme() {
  return themeManager && themeManager.isDarkMode() ? 'dark' : 'light';
}

function getCurrentFontScale() {
  return fontSizeManager ? fontSizeManager.getScale() : 1;
}

function reloadAppState() {
  themeManager?.init();
  fontSizeManager?.init();
  bottomNavigation?.init();
}

function setFocusOnElement(selector) {
  const element = document.querySelector(selector);
  if (element) {
    element.focus();
    element.scrollIntoView({ behavior: 'smooth', block: 'center' });
  }
}

if (typeof module !== 'undefined' && module.exports) {
  module.exports = {
    ThemeManager,
    FontSizeManager,
    BottomNavigation,
    PageTransition,
    getCurrentTheme,
    getCurrentFontScale,
    reloadAppState
  };
}
